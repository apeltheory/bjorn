# Jev (TypeSafe) reads the order and picks the action. Waitlisted early access;
# keys come from console.typesafe.ai. Leave blank until you have one and the
# planner runs on Anthropic alone, exactly as it did before.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
MAX_JEV_CALLS=2000
JEV_MIN_CONFIDENCE=0.40

# Anthropic gives him his voice. With a Jev key it is called only when he talks;
# without one it does the deciding too.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
MAX_API_CALLS=100

# Optional: let him select his character and join by himself.
# A dedicated server address as ip:port. Leave blank to start at the menu.
VALHEIM_SERVER=
VALHEIM_CHARACTER=Bjorn
VALHEIM_PASSWORD=
